# Copy to .env and fill in. Never commit the real .env.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/betterbite

# --- Firebase (Auth / Storage) ---
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
FIREBASE_STORAGE_BUCKET=

# --- AI providers (kept server-side only) ---
AI_VISION_PROVIDER=          # e.g. openai | gemini
AI_VISION_API_KEY=
AI_TEXT_PROVIDER=
AI_TEXT_API_KEY=

# --- App ---
ENV=local                    # local | staging | production
API_BASE_PATH=/api/v1
